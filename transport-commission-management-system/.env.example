# Backend Environment Configuration
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/transport_system
JWT_SECRET=your_jwt_secret_key_here
NODE_ENV=production
FRONTEND_URL=https://your-company-frontend-domain.com

# Initial Administrator Seed Credentials (Used only on fresh DB setup)
INITIAL_ADMIN_USERNAME=company-admin
INITIAL_ADMIN_PASSWORD=your_secure_admin_password_here

# Frontend Environment Configuration (In frontend/.env)
VITE_API_URL=https://api.your-company-domain.com
